<Window x:Class="TaskFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        xmlns:conv="clr-namespace:TaskFlow.Converters"
        Title="TaskFlow - Gestionnaire de tâches" Height="720" Width="1150"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusToTextConverter x:Key="StatusConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nouvelle" Command="{Binding NewCommand}" />
            <Button Content="Éditer" Command="{Binding EditCommand}" />
            <Button Content="Supprimer" Command="{Binding DeleteCommand}" />
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" />
        </StackPanel>

        <!-- Recherche et filtre -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Recherche :" VerticalAlignment="Center" Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Column="2" Text="Statut :" VerticalAlignment="Center" Margin="16,0,8,0" />

            <ComboBox Grid.Column="3"
                      Width="140"
                      ItemsSource="{Binding StateFilters}"
                      SelectedItem="{Binding StateFilter}" />
        </Grid>

        <!-- Statistiques -->
        <Border Grid.Row="2" Background="#F2F2F2" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Total, StringFormat='Total : {0}'}" />
                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Done, StringFormat='Terminées : {0}'}" />
                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Late, StringFormat='En retard : {0}'}" />
                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Progress, StringFormat='Avancement : {0} %'}" />
            </StackPanel>
        </Border>

        <!-- Liste des tâches -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False">

            <ListView x:Name="TasksList"
                      ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      MouseDoubleClick="TasksList_MouseDoubleClick"
                      VirtualizingStackPanel.IsVirtualizing="False"
                      VirtualizingStackPanel.VirtualizationMode="Standard">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" Width="55" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Titre" Width="300" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Projet" Width="170" DisplayMemberBinding="{Binding Project}" />
                        <GridViewColumn Header="Responsable" Width="120" DisplayMemberBinding="{Binding Assignee}" />

                        <GridViewColumn Header="Priorité" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DataTemplate.Resources>
                                        <conv:PriorityToBrushConverter x:Key="PriorityBrush" />
                                    </DataTemplate.Resources>
                                    <TextBlock Text="{Binding Priority}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Priority, Converter={StaticResource PriorityBrush}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Statut" Width="100"
                                        DisplayMemberBinding="{Binding State, Converter={StaticResource StatusConverter}}" />

                        <GridViewColumn Header="Échéance" Width="110"
                                        DisplayMemberBinding="{Binding DueDateTime, StringFormat=dd/MM/yyyy}" />

                        <GridViewColumn Header="Charge (h)" Width="90" DisplayMemberBinding="{Binding EstimatedHours}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <!-- Barre d'état -->
        <Border Grid.Row="4" Background="#E8E8E8" Padding="8,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
